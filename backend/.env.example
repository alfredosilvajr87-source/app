# Copie este arquivo para .env e preencha os valores
# No Render.com, configure estas variáveis em: Dashboard > seu serviço > Environment

# MongoDB Atlas (grátis 512MB)
# Crie em: https://cloud.mongodb.com
MONGO_URL=mongodb+srv://SEU_USUARIO:SUA_SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=lacucina_db

# CORS - coloque a URL do seu frontend no Vercel
# Exemplo: https://kitchen-app.vercel.app
CORS_ORIGINS=https://SEU-APP.vercel.app

# JWT Secret - coloque qualquer string longa e aleatória
JWT_SECRET=mude-isso-para-uma-chave-secreta-longa-2024

# Master Key - protege criação/exclusão de empresas (super-admin)
# Escolha uma senha forte e guarde em segurança!
# Sem esta variável, a criação de novas empresas estará BLOQUEADA.
MASTER_KEY=sua-chave-master-secreta-aqui

# Email (opcional - para reset de senha)
# Pode deixar vazio se não usar
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
